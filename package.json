{
  "name": "clinic-virtual-queue",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time clinic queue notification engine",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names \"API,UI\" --prefix-colors \"cyan,magenta\" \"node src/server.js\" \"vite\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "node src/server.js",
    "start": "npm run build && node src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@tailwindcss/postcss": "latest",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "latest",
    "lucide-react": "latest",
    "qrcode": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "ws": "latest"
  },
  "devDependencies": {
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^10.0.5"
  }
}
