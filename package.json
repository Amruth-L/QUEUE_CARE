{
  "name": "clinic-virtual-queue",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time clinic queue notification engine",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names \"API,UI\" --prefix-colors \"cyan,magenta\" \"node src/server.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node src/server.js",
    "start": "npm run build && node src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "lucide-react": "1.45.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.6",
    "concurrently": "10.0.6",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
